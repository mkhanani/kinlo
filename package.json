{
  "name": "kinlo",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Local-first personal CRM for desktop with bring-your-own-key AI.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "lint:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "check": "npm run typecheck && npm run test && npm run lint:rust && npm run test:rust",
    "tauri": "tauri",
    "app:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "app:build:staging": "tauri build --config src-tauri/tauri.staging.conf.json",
    "app:build": "tauri build",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.107",
    "@ai-sdk/google": "^4.0.124",
    "@ai-sdk/openai": "^4.0.122",
    "@ai-sdk/openai-compatible": "^3.0.94",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@tanstack/react-query": "^5.108.2",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-http": "^2.9.0",
    "@tauri-apps/plugin-notification": "^2.8.1",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-os": "^2.4.0",
    "@tauri-apps/plugin-sql": "^2.6.0",
    "ai": "^7.0.179",
    "lucide-react": "^1.77.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@sqlite.org/sqlite-wasm": "^3.54.1-build1",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.6",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22.13"
  }
}
